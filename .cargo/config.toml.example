# Fast-build config example (mold + sccache). The real .cargo/config.toml
# is machine-local and gitignored. To opt in on any machine:
#   sed "s|/home/<you>|$HOME|" .cargo/config.toml.example > .cargo/config.toml
# (Standard layout: this repo at ~/projects/codex-connect, shared toolchain
# at ~/projects/.tools. Adjust the paths if your layout differs.)

[target.x86_64-unknown-linux-gnu]
linker = "gcc"
rustflags = [
    "-C", "link-arg=-B/home/<you>/projects/.tools/bin",
    "-C", "link-arg=-fuse-ld=mold",
]

[env]
SCCACHE_DIR = { value = "/home/<you>/projects/.tools/sccache_cache", force = true }

[build]
rustc-wrapper = "/home/<you>/projects/.tools/bin/sccache"
